   # gateway (local bundle = has all fixes; published 0.9.3 does NOT)
   rm -rf /tmp/ag-mcp && agentide init --data-dir /tmp/ag-mcp --default-tenant acme
   setsid node agentide/packages/agentide/dist/bin.bundled.cjs gateway start --data-dir /tmp/ag-mcp --all-doors --foreground &
