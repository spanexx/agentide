{
  "name": "@spanexx/dashboard-core",
  "version": "0.0.4",
  "private": false,
  "description": "Web dashboard for Agentide \u2014 dashboard.view.* read caps (thin passthrough wrappers) + static UI server. BI[13].",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/assets",
    "src"
  ],
  "scripts": {
    "build": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty",
    "sim": "node scripts/serve-sim.mjs",
    "prepublishOnly": "bash scripts/prepare-publish.sh"
  },
  "dependencies": {
    "@spanexx/capability-registry": "workspace:*",
    "@spanexx/errors": "workspace:*",
    "@spanexx/event-bus": "workspace:*",
    "@spanexx/gateway-core": "workspace:*",
    "@spanexx/plugin-manager": "workspace:*",
    "@spanexx/session-manager": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "workspace:*",
    "typescript": "workspace:*",
    "vitest": "workspace:*",
    "eslint": "workspace:*",
    "@typescript-eslint/parser": "workspace:*",
    "@typescript-eslint/eslint-plugin": "workspace:*"
  },
  "license": "MIT",
  "keywords": [
    "agentide",
    "dashboard",
    "platform"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12"
  }
}
