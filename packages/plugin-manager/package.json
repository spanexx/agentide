{
  "name": "@spanexx/plugin-manager",
  "version": "0.0.0",
  "private": true,
  "description": "In-process control-plane component that installs/updates/disables/enables/reloads/uninstalls/lists plugins from a local Plugin Manifest.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty"
  },
  "dependencies": {
    "yaml": "^2.6.0",
    "@spanexx/capability-registry": "workspace:*",
    "@spanexx/event-bus": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "eslint": "^10.8.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0"
  }
}
