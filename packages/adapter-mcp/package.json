{
  "name": "@spanexx/adapter-mcp",
  "version": "0.7.0",
  "private": false,
  "description": "MCP adapter — exposes the Agentide gateway as MCP tools over Streamable HTTP (POST /mcp).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty",
    "prepublishOnly": "bash scripts/prepare-publish.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@spanexx/errors": "workspace:*",
    "@spanexx/gateway-core": "workspace:*",
    "@spanexx/adapter-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "@spanexx/backend-runtime": "workspace:*",
    "@spanexx/capability-registry": "workspace:*",
    "@spanexx/event-bus": "workspace:*",
    "@spanexx/plugin-manager": "workspace:*",
    "@spanexx/session-manager": "workspace:*"
  },
  "license": "MIT",
  "keywords": [
    "agentide",
    "platform",
    "mcp",
    "model-context-protocol",
    "adapter"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12"
  }
}
