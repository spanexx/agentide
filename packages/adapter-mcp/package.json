{
  "name": "@platform/adapter-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP (Model Context Protocol) adapter — exposes registered capabilities as MCP tools over Streamable HTTP; translates MCP JSON-RPC messages into canonical gateway.handleInvocation() calls.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@platform/errors": "workspace:*",
    "@platform/gateway-core": "workspace:*"
  },
  "devDependencies": {
    "@platform/backend-runtime": "workspace:*",
    "@platform/capability-registry": "workspace:*",
    "@platform/event-bus": "workspace:*",
    "@platform/plugin-manager": "workspace:*",
    "@platform/session-manager": "workspace:*",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
