{
  "name": "@spanexx/adapter-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP (Model Context Protocol) adapter \u2014 exposes registered capabilities as MCP tools over Streamable HTTP; translates MCP JSON-RPC messages into canonical gateway.handleInvocation() calls.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@spanexx/errors": "workspace:*",
    "@spanexx/gateway-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "@spanexx/backend-runtime": "workspace:*",
    "@spanexx/capability-registry": "workspace:*",
    "@spanexx/event-bus": "workspace:*",
    "@spanexx/plugin-manager": "workspace:*",
    "@spanexx/session-manager": "workspace:*"
  }
}
