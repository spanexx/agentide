{
  "name": "@spanexx/event-bus",
  "version": "0.2.0",
  "description": "In-process pub/sub event bus for Agentide platform components.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "agentide",
    "platform",
    "event-bus",
    "pubsub"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty"
  },
  "devDependencies": {
    "typescript": "workspace:*",
    "vitest": "workspace:*",
    "eslint": "workspace:*",
    "@typescript-eslint/parser": "workspace:*",
    "@typescript-eslint/eslint-plugin": "workspace:*"
  },
  "engines": {
    "node": ">=22.12"
  }
}
