{
  "name": "@spanexx/agentide",
  "version": "0.5.0",
  "private": false,
  "description": "Meta-package composing Tier 1 components + gateway-core; ships the `agentide` CLI for operators.",
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "agentide": "./dist/bin.bundled.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "install.sh"
  ],
  "scripts": {
    "build": "tsc --build --pretty && pnpm run bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty",
    "bundle": "esbuild src/bin.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/bin.bundled.cjs --define:CLI_VERSION=\"$(node -p 'JSON.stringify(require(\"./package.json\").version)')\" --banner:js='#!/usr/bin/env node' && chmod +x dist/bin.bundled.cjs",
    "prepublishOnly": "bash scripts/prepare-publish.sh"
  },
  "dependencies": {
    "@spanexx/adapter-mcp": "workspace:*",
    "@spanexx/adapter-websocket": "workspace:*",
    "@spanexx/adapter-rest": "workspace:*",
    "@spanexx/backend-runtime": "workspace:*",
    "@spanexx/capability-registry": "workspace:*",
    "@spanexx/event-bus": "workspace:*",
    "@spanexx/gateway-core": "workspace:*",
    "@spanexx/plugin-manager": "workspace:*",
    "@spanexx/session-manager": "workspace:*",
    "@spanexx/dashboard-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "workspace:*",
    "@types/ws": "workspace:*",
    "@typescript-eslint/eslint-plugin": "workspace:*",
    "@typescript-eslint/parser": "workspace:*",
    "esbuild": "workspace:*",
    "eslint": "workspace:*",
    "jsdom": "workspace:*",
    "typescript": "workspace:*",
    "vitest": "workspace:*",
    "ws": "workspace:*"
  },
  "license": "MIT",
  "keywords": [
    "agentide",
    "platform",
    "gateway",
    "cli",
    "mcp",
    "websocket",
    "capabilities"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12"
  }
}
