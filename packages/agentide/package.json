{
  "name": "@platform/agentide",
  "version": "0.0.0",
  "private": true,
  "description": "Meta-package composing Tier 1 components + gateway-core; ships the `agentide` CLI for operators.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentide": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "install.sh"
  ],
  "scripts": {
    "build": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty"
  },
  "dependencies": {
    "@platform/adapter-mcp": "workspace:*",
    "@platform/backend-runtime": "workspace:*",
    "@platform/capability-registry": "workspace:*",
    "@platform/event-bus": "workspace:*",
    "@platform/gateway-core": "workspace:*",
    "@platform/plugin-manager": "workspace:*",
    "@platform/session-manager": "workspace:*"
  },
  "devDependencies": {
    "@platform/sdk-browser": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  }
}