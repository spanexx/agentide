{
  "name": "@platform/agentide",
  "version": "0.0.0",
  "private": true,
  "description": "Meta-package composing Tier 1 components + gateway-core; ships the `agentide` CLI for operators.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentide": "./dist/cli.js"
  },
  "files": ["dist", "src", "install.sh"],
  "scripts": {
    "build": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty"
  },
  "dependencies": {
    "@platform/capability-registry": "0.0.0",
    "@platform/event-bus": "0.0.0",
    "@platform/gateway-core": "0.0.0",
    "@platform/plugin-manager": "0.0.0",
    "@platform/session-manager": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "eslint": "^10.8.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0"
  }
}