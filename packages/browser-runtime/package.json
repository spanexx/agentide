{
  "name": "@spanexx/browser-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Browser Runtime plugin \u2014 drives a real Chromium via Playwright on behalf of an agent session: launch/close browser, open/list/close tabs, navigate, click, type, scroll, wait, screenshot, query.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "manifest.yaml"
  ],
  "scripts": {
    "build": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty"
  },
  "dependencies": {
    "@playwright/browser-chromium": "1.62.1",
    "playwright-core": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "workspace:*",
    "@typescript-eslint/eslint-plugin": "workspace:*",
    "@typescript-eslint/parser": "workspace:*",
    "eslint": "workspace:*",
    "typescript": "workspace:*",
    "vitest": "workspace:*",
    "yaml": "workspace:*"
  }
}
