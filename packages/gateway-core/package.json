{
  "name": "@spanexx/gateway-core",
  "version": "0.1.1",
  "private": false,
  "description": "The kernel. Single function handleInvocation(req) → response. Auth → rate limit → session → authz (tier-hierarchy) → version resolve → dispatch (by owner prefix).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty",
    "prepublishOnly": "bash scripts/prepare-publish.sh"
  },
  "dependencies": {
    "@spanexx/backend-runtime": "workspace:*",
    "@spanexx/capability-registry": "workspace:*",
    "@spanexx/errors": "workspace:*",
    "@spanexx/event-bus": "workspace:*",
    "@spanexx/origin": "workspace:*",
    "@spanexx/platform-capabilities": "workspace:*",
    "@spanexx/plugin-manager": "workspace:*",
    "@spanexx/session-manager": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "eslint": "^10.8.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0"
  },
  "license": "MIT",
  "keywords": [
    "agentide",
    "platform",
    "gateway",
    "kernel",
    "dispatch",
    "routing"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  }
}
