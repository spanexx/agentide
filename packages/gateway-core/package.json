{
  "name": "@spanexx/gateway-core",
  "version": "0.7.1",
  "private": false,
  "description": "The kernel. Single function handleInvocation(req) \u2192 response. Auth \u2192 rate limit \u2192 session \u2192 authz (tier-hierarchy) \u2192 version resolve \u2192 dispatch (by owner prefix).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty",
    "prepublishOnly": "bash scripts/prepare-publish.sh"
  },
  "dependencies": {
    "@spanexx/backend-runtime": "workspace:*",
    "@spanexx/capability-registry": "workspace:*",
    "@spanexx/errors": "workspace:*",
    "@spanexx/event-bus": "workspace:*",
    "@spanexx/origin": "workspace:*",
    "@spanexx/platform-capabilities": "workspace:*",
    "@spanexx/plugin-manager": "workspace:*",
    "@spanexx/session-manager": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "workspace:*",
    "typescript": "workspace:*",
    "vitest": "workspace:*",
    "eslint": "workspace:*",
    "@typescript-eslint/parser": "workspace:*",
    "@typescript-eslint/eslint-plugin": "workspace:*"
  },
  "license": "MIT",
  "keywords": [
    "agentide",
    "platform",
    "gateway",
    "kernel",
    "dispatch",
    "routing"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12"
  }
}
