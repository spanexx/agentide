{
  "name": "@spanexx/session-manager",
  "version": "0.6.1",
  "private": false,
  "description": "Lifecycle manager for execution contexts. Active \u21c4 Suspended \u2192 Archived. Sessions own their runtime resources.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty",
    "prepublishOnly": "bash scripts/prepare-publish.sh"
  },
  "dependencies": {
    "@spanexx/event-bus": "workspace:*"
  },
  "devDependencies": {
    "typescript": "workspace:*",
    "vitest": "workspace:*",
    "eslint": "workspace:*",
    "@typescript-eslint/parser": "workspace:*",
    "@typescript-eslint/eslint-plugin": "workspace:*"
  },
  "license": "MIT",
  "keywords": [
    "agentide",
    "platform",
    "sessions",
    "lifecycle"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12"
  }
}
