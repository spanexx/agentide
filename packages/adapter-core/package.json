{
  "name": "@spanexx/adapter-core",
  "version": "0.3.1",
  "private": false,
  "description": "Shared server-side invocation pipeline for door adapters \u2014 readClaims, auth policy, error converter, RecordRegistry, response channel, capability lookup. Doors import ONLY this package for shared logic (A1 own-bytes rule).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty",
    "prepublishOnly": "bash scripts/prepare-publish.sh"
  },
  "dependencies": {
    "@spanexx/errors": "workspace:*",
    "@spanexx/gateway-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "workspace:*",
    "typescript": "workspace:*",
    "vitest": "workspace:*",
    "eslint": "workspace:*",
    "@typescript-eslint/parser": "workspace:*",
    "@typescript-eslint/eslint-plugin": "workspace:*"
  },
  "license": "MIT",
  "keywords": [
    "agentide",
    "platform",
    "adapter",
    "pipeline"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12"
  }
}
