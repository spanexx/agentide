{
  "name": "@spanexx/backend-runtime",
  "version": "0.1.1",
  "private": false,
  "description": "Gateway-side counterpart to sdk-node/sdk-browser. Accepts SDK WS connections, performs HS256 JWT handshake, threads runtime capabilities into the gateway's dispatch.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty",
    "prepublishOnly": "bash scripts/prepare-publish.sh"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "@spanexx/capability-registry": "workspace:*",
    "@spanexx/errors": "workspace:*",
    "@spanexx/event-bus": "workspace:*",
    "@spanexx/origin": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "eslint": "^10.8.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0"
  },
  "license": "MIT",
  "keywords": [
    "agentide",
    "platform",
    "sdk",
    "runtime",
    "backend"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12"
  }
}
