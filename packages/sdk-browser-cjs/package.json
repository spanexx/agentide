{
  "name": "@spanexx/sdk-browser-cjs",
  "version": "0.0.1",
  "description": "CommonJS build of @spanexx/sdk-browser — for CJS consumers. Source is mirrored from @spanexx/sdk-browser; updated in lockstep. Note: the SDK targets browsers (native WebSocket, DOM APIs); the CJS variant is for SSR/Node-only consumers.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "agentide",
    "platform",
    "sdk",
    "browser",
    "frontend",
    "capabilities",
    "commonjs",
    "cjs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "lint": "echo 'linted at mirror time'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@spanexx/event-bus-cjs": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}