{
  "name": "@spanexx/sdk-browser",
  "version": "0.0.3",
  "description": "Browser SDK for Agentide \u2014 the DOM is the manifest. Annotate elements with data-sdk-cap, createSdk observes and registers capabilities, invocations fan out as CustomEvents.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "agentide",
    "platform",
    "sdk",
    "browser",
    "frontend",
    "capabilities"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty"
  },
  "dependencies": {
    "@spanexx/event-bus": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "jsdom": "^30.0.1",
    "eslint": "^10.8.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@spanexx/backend-runtime": "workspace:*"
  }
}
