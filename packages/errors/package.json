{
  "name": "@spanexx/errors",
  "version": "0.0.4",
  "private": false,
  "description": "Structured error type used across every Agentide package. Replaces thrown Error with {code, message, details?} shape.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build --pretty",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --build --pretty",
    "prepublishOnly": "bash scripts/prepare-publish.sh"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "eslint": "^10.8.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0"
  },
  "license": "MIT",
  "keywords": [
    "agentide",
    "platform",
    "errors",
    "typed-errors"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {}
}
